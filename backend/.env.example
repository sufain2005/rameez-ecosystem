# Rameez Kitchen Backend Environment Configuration
# Deployment Port (set automatically by cloud providers like Render/Railway/Heroku)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Configuration
# Option A: Cloud Connection String (e.g. Render, Supabase, Neon, AWS)
# DATABASE_URL=postgresql://user:password@host:5432/rameez_kitchen_db?sslmode=require

# Option B: Individual Connection Parameters
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rameez_kitchen_db
DB_SSL=false

# Authentication & Security Secrets
DRIVER_JWT_SECRET=super_secret_rameez_kitchen_key_2026
MERCHANT_JWT_SECRET=super_secret_rameez_merchant_executive_key_2026
APP_SIGNING_SECRET=rk_sec_994bfa283c07f45a8e10d287bc12

# Admin Seed Account
ADMIN_USERNAME=postgres
ADMIN_EMAIL=admin@rameezkitchen.com
ADMIN_PHONE=8073349233
ADMIN_PASSWORD=your_admin_password

# Allowed CORS Origins (comma-separated or * for public access)
CORS_ORIGIN=*
