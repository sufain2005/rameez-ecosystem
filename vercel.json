{
  "version": 2,
  "outputDirectory": "flutter_apps/customer_app/build/web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}

